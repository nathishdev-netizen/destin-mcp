# Destin MCP Server Environment Configuration

# Server Configuration
LOG_LEVEL=INFO
PYTHONPATH=/app/src

# API Configuration
BASE_URL=https://supplier-apis-for-travel-tech.vercel.app
DEFAULT_SUPPLIER=dida
REQUEST_TIMEOUT=30

# Hotel API Settings
DEFAULT_CURRENCY=USD
MAX_HOTELS_PER_SEARCH=50

# Security (if needed later)
# API_KEY=your_api_key_here
# JWT_SECRET=your_jwt_secret_here

# Database (if you add one later)
# DATABASE_URL=postgresql://user:password@localhost:5432/destin_mcp

# Monitoring (if you add it later)
# SENTRY_DSN=your_sentry_dsn_here
